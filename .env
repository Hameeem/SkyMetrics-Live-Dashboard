# SkyMetrics Environment Configuration

# General Configuration
APP_NAME=SkyMetrics
APP_ENV=development
SECRET_KEY=skymetrics-secret-key-super-secure-production-ready-2026
DEBUG=True

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_URL=http://localhost:8000

# Database Configuration
# Uses PostgreSQL by default; falls back to local SQLite if PostgreSQL is unreachable or empty
DATABASE_URL=sqlite:///./skymetrics.db
# Example Postgres: postgresql://postgres:postgres@localhost:5432/skymetrics_db

# External API Keys (Optional - Fallback simulation generators active when keys not provided)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENWEATHER_API_KEY=

# ML Configuration
MODEL_PATH=ml/artifacts/delay_model.joblib

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
